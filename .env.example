# ==========================================
# InternOS Environment Configuration
# ==========================================

# Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internos?schema=public"

# Authentication & Security
JWT_SECRET="internos_super_secret_jwt_key_phase0_development_only_min_32_chars"
JWT_EXPIRES_IN="7d"

# Multi-Tenancy & Cookie Configuration
COOKIE_DOMAIN="localhost"
DEFAULT_ORGANIZATION_CODE="apex-inst"

# File Storage Abstraction (local | s3 | gcs)
STORAGE_DRIVER="local"
STORAGE_LOCAL_UPLOAD_DIR="./uploads"
STORAGE_MAX_FILE_SIZE_MB=25
# S3 / Object storage credentials placeholder:
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""

# AI / LLM Configuration Placeholder (DO NOT ACTIVATE IN PHASE 0)
LLM_PROVIDER="openai"
LLM_API_KEY="placeholder_not_used_in_phase_0"
LLM_MODEL="gpt-4o"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
