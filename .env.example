# ==========================================
# InternOS Environment Configuration Template
# PRODUCTION NOTE: Never commit real keys, secrets, or passwords to git.
# Copy this file to .env and fill in secure values for your deployment.
# ==========================================

# Environment
NODE_ENV=production
PORT=4000
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# Database (PostgreSQL via Prisma ORM)
# Example: postgresql://<username>:<password>@<db-host>:5432/<database>?schema=public
DATABASE_URL="postgresql://db_user:change_this_secure_password@localhost:5432/internos?schema=public"

# Authentication & Security
# Generate a cryptographically secure 64-char key (e.g. `openssl rand -base64 48`)
JWT_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

# Multi-Tenancy & Cookie Configuration
COOKIE_DOMAIN=".yourdomain.com"
DEFAULT_ORGANIZATION_CODE="ORG_A"

# File Storage Abstraction (local | s3 | gcs)
STORAGE_DRIVER="local"
STORAGE_LOCAL_UPLOAD_DIR="./uploads"
STORAGE_MAX_FILE_SIZE_MB=25

# S3 Object Storage (Required if STORAGE_DRIVER=s3)
STORAGE_S3_BUCKET="your-s3-bucket-name"
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_ACCESS_KEY="YOUR_AWS_ACCESS_KEY_ID_PLACEHOLDER"
STORAGE_S3_SECRET_KEY="YOUR_AWS_SECRET_ACCESS_KEY_PLACEHOLDER"

# AI / LLM Configuration (Advisory evidence-based analysis)
LLM_PROVIDER="openai"
LLM_API_KEY="sk-placeholder-do-not-commit-real-keys"
LLM_MODEL="gpt-4o"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

